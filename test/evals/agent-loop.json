{
  "schemaVersion": 1,
  "title": "Farai Agent Loop JSON Self-Test",
  "cases": [
    {
      "name": "json note memory",
      "prompts": ["remember json suite target context"],
      "expect": {
        "notesAtLeast": 1,
        "events": ["tool_call", "tool_result", "loop_stop"],
        "stopReasons": ["final_response"]
      }
    },
    {
      "name": "json malformed repair",
      "planner": "malformed-once",
      "prompts": ["trigger malformed output"],
      "expect": {
        "responseIncludes": ["Recovered from malformed"],
        "events": ["planner_error"],
        "stopReasons": ["final_response"]
      }
    }
  ]
}
